{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-film.py\"",
            "timeout": 10,
            "statusMessage": "Checking the work"
          }
        ]
      }
    ]
  }
}
